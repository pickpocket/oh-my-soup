# syntax=docker/dockerfile:1.7-labs
###############################################################################
# roboms — GitHub triage+fix bot orchestrator.
#
# Extends `pi-base` (from /Dockerfile, default target oh-my-soup/pi:dev) and adds
# the roboms Python package + a Vite-built SolidJS dashboard bundle. The pi
# toolchain (python + bun + rustup launcher + pi-natives + oms_rpc wheel +
# /usr/local/bin/oms shim) all comes from PI_BASE; this file only layers what's
# roboms-specific.
#
# Build (from pi root):
#     bun run pi:image                              # build oh-my-soup/pi:dev first
#     docker build -f Dockerfile.roboms -t roboms:dev .
#
# Compose (recommended):
#     docker compose --project-directory python/roboms build
###############################################################################

ARG PI_BASE=oh-my-soup/pi:dev
ARG BUN_VERSION=1.4.2

############################
# 1) web-builder — Bun + Vite, builds the SolidJS dashboard bundle.
############################
FROM oven/bun:${BUN_VERSION}-slim AS web-builder
WORKDIR /work
# Root manifests + the web workspace manifest are enough for `bun install
# --filter roboms-web` to hydrate just the dashboard's node_modules.
COPY package.json bun.lock ./
COPY python/roboms/web/package.json ./python/roboms/web/package.json
# Root package.json declares patchedDependencies, so the patch file must be
# present before any root-level `bun install` (even a filtered one).
COPY patches/*.patch ./patches/
RUN bun install --filter roboms-web
COPY --exclude=node_modules --exclude=dist python/roboms/web/ ./python/roboms/web/
RUN bun --cwd=python/roboms/web run build

############################
# 2) runtime — pi-base + roboms src + web bundle + pip install
############################
FROM ${PI_BASE} AS runtime

# roboms runs against the host pi checkout mounted at /work/pi read-only.
ENV PI_ROOT=/work/pi

WORKDIR /app

# roboms is an MIT product; OMS's dual-license payload remains available from
# the inherited base image under /usr/share/doc/oms.
COPY LICENSE THIRD-PARTY-NOTICES.txt /usr/share/doc/roboms/

# roboms itself. Drop the Vite-built dashboard into the package tree before
# `pip install` so it lands in the installed wheel (`static/**/*` is declared
# as package-data in pyproject.toml).
COPY python/roboms/pyproject.toml ./
COPY python/roboms/src/ ./src/
COPY --from=web-builder /work/python/roboms/web/dist/ ./src/static/

RUN pip install --no-cache-dir \
        "fastapi>=0.112" "uvicorn[standard]>=0.30" "httpx>=0.27" \
        "pydantic>=2.6" "pydantic-settings>=2.2" "python-dotenv>=1.0" \
        "click>=8.1" \
    && pip install --no-cache-dir --no-deps .

# Host agent config is mounted read-only under /srv/agent-home-stage with
# host-controlled permissions. The entrypoint copies it into root-owned
# world-readable files under /srv/agent-home; the agent subprocess runs with
# HOME=/srv/agent-home, so ~/.oms and ~/.agent resolve there without exposing
# mutable host mounts.
RUN mkdir -p /srv/agent-home/.agent /srv/agent-home/.oms/agent \
    && mkdir -p /srv/agent-home-stage/.agent /srv/agent-home-stage/.oms/agent \
    && printf '[install]\nbackend = "copyfile"\n' > /srv/agent-home/.bunfig.toml

COPY python/roboms/entrypoint.sh /usr/local/bin/roboms-entrypoint
RUN chmod +x /usr/local/bin/roboms-entrypoint

VOLUME ["/data"]
EXPOSE 8080
EXPOSE 8081

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/roboms-entrypoint"]
CMD ["python", "-m", "roboms", "serve"]
