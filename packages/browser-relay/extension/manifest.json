{
	"manifest_version": 3,
	"name": "OMS Browser Relay",
	"version": "0.1.0",
	"description": "Lets the oms coding agent drive your existing tabs through a local CDP relay.",
	"author": "Can Boluk",
	"homepage_url": "https://github.com/pickpocket/oh-my-soup",
	"permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
	"background": {
		"service_worker": "background.js"
	},
	"options_page": "options.html",
	"action": {
		"default_title": "OMS Browser Relay (click for settings)"
	}
}
