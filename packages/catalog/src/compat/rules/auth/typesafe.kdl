// TypeSafe (System One judgments) answers typed questions (choice / yes-no / score)
// over JSON state via `POST /v1/systemone`, consumed through
// `@oh-my-soup/pi-ai`'s `TypeSafeJudge`. It has no separate chat-model provider
// entry; judgment models are catalogued under the `judge` kind. This auth entry
// supplies live `/v1/models` discovery and requests, while the judgment resolver
// checks the credential.
auth "typesafe" {
	name "TypeSafe"
	env "TYPESAFE_API_KEY"
	login "api-key" {
		auth-url "https://console.typesafe.ai/"
		instructions "Create or copy your API key from the TypeSafe console."
		prompt "Paste your TypeSafe API key" placeholder="API key"
		validate "models-endpoint" label="TypeSafe" url="https://api.typesafe.ai/v1/models" base-url-env="TYPESAFE_BASE_URL"
	}
}
