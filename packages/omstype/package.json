{
  "type": "module",
  "name": "@oh-my-soup/omstype",
  "version": "17.5.1",
  "description": "ArkType-compatible runtime schema validation with lazy JIT compilation",
  "homepage": "https://github.com/pickpocket/oh-my-soup",
  "author": "Can Boluk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pickpocket/oh-my-soup.git",
    "directory": "packages/omstype"
  },
  "bugs": {
    "url": "https://github.com/can1357/oh-my-pi/issues"
  },
  "keywords": [
    "schema",
    "validation",
    "arktype",
    "jit"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "test": "bun test --parallel",
    "bench": "bun bench/bench.ts"
  },
  "devDependencies": {
    "@ark/attest": "0.56.3",
    "@ark/schema": "0.56.2",
    "@ark/util": "0.56.2",
    "@sinclair/typebox": "^0.34.0",
    "@types/bun": "catalog:",
    "arkregex": "0.0.8",
    "arktype": "2.2.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  }
}
