{
	"type": "module",
	"name": "@oh-my-soup/tool-views",
	"version": "0.0.1",
	"private": true,
	"description": "Shared React per-tool renderers and <oms-tool-view> bundle for HTML session exports",
	"homepage": "https://github.com/pickpocket/oh-my-soup",
	"author": "Can Boluk",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pickpocket/oh-my-soup.git",
		"directory": "packages/tool-views"
	},
	"bugs": {
		"url": "https://github.com/pickpocket/oh-my-soup/issues"
	},
	"scripts": {
		"gen:tool-views": "bun scripts/build-tool-views.ts",
		"test": "bun test --parallel",
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.{ts,tsx}' '*.ts' && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.{ts,tsx}' '*.ts'"
	},
	"dependencies": {
		"@oh-my-soup/pi-utils": "catalog:",
		"@oh-my-soup/pi-wire": "catalog:",
		"katex": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
