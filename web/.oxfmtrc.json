{
	"useTabs": true,
	"tabWidth": 3,
	"printWidth": 120,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "avoid",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"ignorePatterns": ["vendor/**/*", "node_modules/**/*", "dist/**/*"]
}
